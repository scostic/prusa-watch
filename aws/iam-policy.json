{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeClaudeHaikuEU",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:eu-central-1:ACCOUNT_ID:inference-profile/eu.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    {
      "Sid": "SendAlertEmailFromOneAddress",
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": "arn:aws:ses:eu-central-1:ACCOUNT_ID:identity/*",
      "Condition": {
        "StringEquals": { "ses:FromAddress": "FROM_ADDRESS" }
      }
    },
    {
      "Sid": "HeartbeatMetricOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "PrusaWatch" }
      }
    }
  ]
}
